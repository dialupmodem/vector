@model ApplicationListViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Applications</h1>

    <a asp-controller="Applications" asp-action="Create" class="btn btn-primary">Add Application</a>
</div>
@if (!Model.Applications.Any())
{
    <div class="alert alert-secondary">
        No applications yet.
    </div>
}
else
{
    <table id="applications-table" class="table">
        <thead>
            <tr>
                <th>Company</th>
                <th>Position</th>
                <th>Status</th>
                <th>Date Applied</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var application in Model.Applications)
            {
                <tr>
                    <td>@application.Company</td>
                    <td>@application.JobTitle</td>
                    <td>@application.ApplicationStatus</td>
                    <td>@application.DateApplied?.ToString("MMM d, yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@application.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Details" asp-route-id="@application.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div id="applications-grid"></div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const table = document.getElementById("applications-table")

            new gridjs.Grid({
                from: table,
                search: true,
                sort: true,
                pagination: {
                    enabled: true,
                    limit: 10
                }
            }).render(document.getElementById("applications-grid"))

            table.remove()
        })
    </script>
}