@model EditApplicationViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Add Application";
}

<h1>Add Application</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div class="mb-3">
        <label asp-for="Company" class="form-label"></label>
        <input asp-for="Company" class="form-control" />
        <span asp-validation-for="Company" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="JobTitle" class="form-label"></label>
        <input asp-for="JobTitle" class="form-control" />
        <span asp-validation-for="JobTitle" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label for="ApplicationStatusId" class="form-label">Status</label>
        <select asp-for="ApplicationStatusId" asp-items="Model.StatusOptions" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="DateApplied" class="form-label"></label>
        <input asp-for="DateApplied" class="form-control" type="date" />
    </div>
    <div class="mb-3">
        <label asp-for="JobUrl" class="form-label"></label>
        <input asp-for="JobUrl" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="JobDescription" class="form-label"></label>
        <textarea asp-for="JobDescription" class="form-control" rows="12"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="JobLocation" class="form-label"></label>
        <input asp-for="JobLocation" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="JobSalary" class="form-label"></label>
        <input asp-for="JobSalary" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="JobSource" class="form-label"></label>
        <input asp-for="JobSource" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>